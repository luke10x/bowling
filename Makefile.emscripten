# vim: set tabstop=4 shiftwidth=4 expandtab noexpandtab:
VERSION_SCRIPT := $(PWD)/scripts/increment_build_version.sh
VERSION_HEADER := $(PWD)/build/generated/build_version.h
VERSION_JSON := $(PWD)/build/emscripten/www/version.json
STAMPED_SW := $(PWD)/build/emscripten/www/sw.js
INKSCAPE ?= /Applications/Inkscape.app/Contents/MacOS/inkscape
PWA_LOGO := $(PWD)/assets/artwork/logo.svg
PWA_LOGO_OUTPUT := $(PWD)/build/emscripten/www/logo.svg
PWA_ICON_192 := $(PWD)/build/emscripten/www/icon-192.png
PWA_ICON_512 := $(PWD)/build/emscripten/www/icon-512.png
TXL_SCRIPT := $(PWD)/scripts/generate_txl.py
TXL_SOURCES := $(wildcard $(PWD)/tegel/txl_*.h)
TXL_GENERATED := $(PWD)/tegel/generated/txl_generated.h
TXL_FONT_ROBOTO := $(PWD)/tegel/generated/txl_font_roboto_regular.h
TXL_FONT_NOTO := $(PWD)/tegel/generated/txl_font_noto_sans_regular.h
TXL_FONT_NOTO_JP := $(PWD)/tegel/generated/txl_font_noto_sans_jp_regular.h
TXL_FONT_NOTO_SC := $(PWD)/tegel/generated/txl_font_noto_sans_sc_regular.h
TXL_FONT_ROBOTO_MONO := $(PWD)/tegel/generated/txl_font_roboto_mono_regular.h
TXL_FONT_GENERATED := $(TXL_FONT_ROBOTO) $(TXL_FONT_NOTO) $(TXL_FONT_NOTO_JP) $(TXL_FONT_NOTO_SC) $(TXL_FONT_ROBOTO_MONO)

FORCE:
include $(PWD)/scripts/font_atlas_audit.mk

$(VERSION_HEADER): FORCE $(VERSION_SCRIPT)
	@bash $(VERSION_SCRIPT)

$(VERSION_JSON): $(VERSION_HEADER) Makefile.emscripten
	@mkdir -p $(dir $@)
	@awk 'BEGIN { version = "" } /^#define BOWLING_BUILD_VERSION / { version = $$3; gsub(/"/, "", version) } END { printf "{\n  \"buildVersion\": \"%s\"\n}\n", version }' $(VERSION_HEADER) > $@

$(STAMPED_SW): $(VERSION_HEADER) $(PWD)/wasm/sw.js Makefile.emscripten
	@mkdir -p $(dir $@)
	@version=$$(awk 'BEGIN { version = "" } /^#define BOWLING_BUILD_VERSION / { version = $$3; gsub(/"/, "", version) } END { print version }' $(VERSION_HEADER)); \
	sed "s/__BUILD_VERSION__/$$version/g" $(PWD)/wasm/sw.js > $@

$(PWA_LOGO_OUTPUT): $(PWA_LOGO) Makefile.emscripten
	@mkdir -p $(dir $@)
	cp $< $@

$(PWA_ICON_192): $(PWA_LOGO)
	@mkdir -p $(dir $@)
	$(INKSCAPE) $< --export-area-page --export-type=png --export-width=192 --export-height=192 --export-background-opacity=0 --export-filename="$@"

$(PWA_ICON_512): $(PWA_LOGO)
	@mkdir -p $(dir $@)
	$(INKSCAPE) $< --export-area-page --export-type=png --export-width=512 --export-height=512 --export-background-opacity=0 --export-filename="$@"

$(TXL_GENERATED): $(TXL_SCRIPT) $(TXL_SOURCES)
	@python3 $(TXL_SCRIPT)

$(TXL_FONT_ROBOTO): $(PWD)/assets/files/Roboto-Regular.ttf
	@mkdir -p $(dir $@)
	@xxd -i -n txl_font_roboto_regular_ttf $< > $@

$(TXL_FONT_NOTO): $(PWD)/assets/files/NotoSans-Regular.ttf
	@mkdir -p $(dir $@)
	@xxd -i -n txl_font_noto_sans_regular_ttf $< > $@

$(TXL_FONT_NOTO_JP): $(PWD)/assets/files/NotoSansJP-Regular.ttf
	@mkdir -p $(dir $@)
	@xxd -i -n txl_font_noto_sans_jp_regular_ttf $< > $@

$(TXL_FONT_NOTO_SC): $(PWD)/assets/files/NotoSansSC-Regular.ttf
	@mkdir -p $(dir $@)
	@xxd -i -n txl_font_noto_sans_sc_regular_ttf $< > $@

$(TXL_FONT_ROBOTO_MONO): $(PWD)/assets/files/RobotoMono-Regular.ttf
	@mkdir -p $(dir $@)
	@xxd -i -n txl_font_roboto_mono_regular_ttf $< > $@

#
# DEPENDENCIES:
# 

BUILD ?= release
WASM_SIMD ?= 1

# Keep the game and Jolt on matching Jolt SIMD definitions. Set WASM_SIMD=0
# for an A/B build with the previous scalar path.
ifeq ($(WASM_SIMD),1)
	JOLT_WASM_SIMD := ON
	WASM_SIMD_FLAGS := -msimd128 -msse4.2
else
	JOLT_WASM_SIMD := OFF
	WASM_SIMD_FLAGS :=
endif

ifeq ($(BUILD),debug)
	OPTFLAGS := -O0 -g3
	LTOFLAGS :=
	JOLT_USE_ASSERTS := ON
	JOLT_DEFINES := -DJPH_PROFILE_ENABLED=1 -DJPH_DEBUG_RENDERER=1 -DJPH_OBJECT_STREAM=1 -DJPH_ENABLE_ASSERTS=1
	EM_ASSERTIONS := -s ASSERTIONS=1
else
	OPTFLAGS := -O3
	LTOFLAGS := -flto
	JOLT_USE_ASSERTS := OFF
	JOLT_DEFINES := -DJPH_OBJECT_STREAM=1 -DNDEBUG
	EM_ASSERTIONS := -s ASSERTIONS=0
endif

JOLT_SRC_DIR=$(PWD)/3rdparty/JoltPhysics
JOLT_BUILD_DIR=build/emscripten/jolt-$(BUILD)-simd$(WASM_SIMD)
JOLT_LIB=$(PWD)/$(JOLT_BUILD_DIR)/lib/libJolt.a

jolt: $(JOLT_LIB)

$(JOLT_LIB): Makefile.emscripten
	rm -rf $(JOLT_BUILD_DIR)
	mkdir -p $(JOLT_BUILD_DIR)
	(cd $(JOLT_BUILD_DIR) && \
	emcmake cmake \
		-DUSE_ASSERTS=$(JOLT_USE_ASSERTS) \
		-DUSE_WASM_SIMD=$(JOLT_WASM_SIMD) \
		-DTARGET_SAMPLES=OFF \
		-DTARGET_UNIT_TESTS=OFF \
		-DTARGET_VIEWER=OFF \
		-DDEBUG_RENDERER_IN_DEBUG_AND_RELEASE=OFF \
		-DPROFILER_IN_DEBUG_AND_RELEASE=OFF \
		-DCPP_EXCEPTIONS_ENABLED=OFF \
		-DCPP_RTTI_ENABLED=OFF \
		-DBUILD_SHARED_LIBS=OFF \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CXX_FLAGS="$(OPTFLAGS) $(LTOFLAGS)" \
		-DCMAKE_EXE_LINKER_FLAGS="$(OPTFLAGS) $(LTOFLAGS)" \
		-DCMAKE_ARCHIVE_OUTPUT_DIRECTORY=$(abspath $(JOLT_BUILD_DIR)/lib) \
		$(abspath $(JOLT_SRC_DIR))/Build && \
	emmake make -j8)

#
# PROGRAM COMPONENTS
# 

CXX = em++
HOST_CXX ?= c++

CXXFLAGS = -std=c++20
CXXFLAGS += -Wno-reorder-init-list
CXXFLAGS += $(OPTFLAGS) $(LTOFLAGS)
CXXFLAGS += $(WASM_SIMD_FLAGS)
CXXFLAGS += -I.

# Web heap policy:
# We prefer a preallocated heap instead of runtime growth, because growth failures are
# abrupt in browsers and make memory regressions harder to reason about. Tune this value
# if startup allocations change substantially.
EM_INITIAL_MEMORY_MB ?= 256
EM_INITIAL_MEMORY_BYTES := $(shell expr $(EM_INITIAL_MEMORY_MB) \* 1024 \* 1024)
EM_SAFE_HEAP ?= 0

# Emscripten writes to its cache during link. In Codex sandbox, the global SDK cache
# path can be non-writable, so we redirect cache into the build folder.
EM_CACHE_DIR=$(PWD)/build/emscripten/em_cache
export EM_CACHE=$(EM_CACHE_DIR)

CXXFLAGS += -I./build/_deps/clay-src
CXXFLAGS += -I./build/_deps/stb-src
CXXFLAGS += -I./3rdparty/JoltPhysics
CXXFLAGS += -I../ymfm/src
CXXFLAGS += -I./3rdparty/glm
CXXFLAGS += $(JOLT_DEFINES)

LDLIBS += $(PWD)/../ymfm/src/ymfm_misc.cpp
LDLIBS += $(PWD)/../ymfm/src/ymfm_adpcm.cpp
LDLIBS += $(PWD)/../ymfm/src/ymfm_ssg.cpp
LDLIBS += $(PWD)/../ymfm/src/ymfm_opn.cpp
LDLIBS += $(PWD)/../eggsfm/xfm_patched_ym3438.cpp
LDLIBS += $(PWD)/../eggsfm/xfm_impl.cpp
LDLIBS += $(PWD)/sounds/sounds.cpp

# Zlib is used by some asset / decompression paths. We keep it enabled, but our build
# redirects `EM_CACHE` into the repo so ports can be reused offline once cached.
LDLIBS += -s USE_ZLIB=1
LDLIBS += -s USE_SDL=2
LDLIBS += $(WASM_SIMD_FLAGS)
LDLIBS += -s FULL_ES2=1 -s USE_WEBGL2=1
LDLIBS += -s ALLOW_MEMORY_GROWTH=0 -s INITIAL_MEMORY=$(EM_INITIAL_MEMORY_BYTES) -s ABORTING_MALLOC=1 -s GL_UNSAFE_OPTS=0
LDLIBS += -s STACK_SIZE=2048kb
LDLIBS += -s EXPORTED_FUNCTIONS=['_main','_Tracker_EmscriptenSongFileLoaded','_Tracker_EmscriptenSongFilePickerClosed','_Sound_EmscriptenEmergencySuspend']
LDLIBS += -s EXPORTED_RUNTIME_METHODS=['ccall']
LDLIBS += $(EM_ASSERTIONS)
ifeq ($(EM_SAFE_HEAP),1)
LDLIBS += -s SAFE_HEAP=1
endif
# LDLIBS += -s USE_PTHREADS=1
LDLIBS += --preload-file $(PWD)/assets/files/everything_tex.png@assets/files/everything_tex.png
LDLIBS += --pre-js $(PWD)/wasm/audio_safety.js
LDLIBS += --shell-file $(PWD)/wasm/shell_itch_io.html

LDLIBS += $(JOLT_LIB)
LDLIBS += $(IMGUI_LIB)

# ImGui library (built separately to avoid recompiling on code changes)
IMGUI_DIR=$(PWD)/3rdparty/imgui
IMGUI_BUILD_DIR=$(PWD)/build/emscripten/imgui
IMGUI_LIB=$(IMGUI_BUILD_DIR)/libimgui.a

imgui-lib: $(IMGUI_LIB)

$(IMGUI_LIB): Makefile.emscripten
	mkdir -p $(IMGUI_BUILD_DIR)
	em++ -c $(OPTFLAGS) $(LTOFLAGS) -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/imgui.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui.o
	em++ -c $(OPTFLAGS) $(LTOFLAGS) -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/imgui_demo.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_demo.o
	em++ -c $(OPTFLAGS) $(LTOFLAGS) -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/imgui_draw.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_draw.o
	em++ -c $(OPTFLAGS) $(LTOFLAGS) -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/imgui_tables.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_tables.o
	em++ -c $(OPTFLAGS) $(LTOFLAGS) -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/imgui_widgets.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_widgets.o
	em++ -c $(OPTFLAGS) $(LTOFLAGS) -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends -s USE_SDL=2 $(IMGUI_DIR)/backends/imgui_impl_sdl2.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_impl_sdl2.o
	em++ -c $(OPTFLAGS) $(LTOFLAGS) -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/backends/imgui_impl_opengl3.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_impl_opengl3.o
	emar rcs $(IMGUI_LIB) $(IMGUI_BUILD_DIR)/*.o

CXXFLAGS += -I$(IMGUI_DIR)
CXXFLAGS += -I$(IMGUI_DIR)/backends

ASSMAN ?= $(PWD)/build/macos/bin/assman
MINIGAME_ANIM_CACHE_HEADER := $(PWD)/assets/xxd_mesh/minigame_anim_cache.h
MINIGAME_ANIM_CACHE_CFG := $(PWD)/assets/assman_minigame_anim_cache.conf
MINIGAME_ANIM_CACHE_SOURCES := \
	$(PWD)/assets/assman_out/angel.anim \
	$(PWD)/assets/assman_out/cherub.anim \
	$(PWD)/assets/assman_out/seraph.anim \
	$(PWD)/assets/assman_out/throne.anim

$(ASSMAN):
	$(MAKE) -f Makefile.mac assman

$(MINIGAME_ANIM_CACHE_HEADER): $(ASSMAN) $(MINIGAME_ANIM_CACHE_CFG) $(MINIGAME_ANIM_CACHE_SOURCES)
	mkdir -p $(dir $@)
	$(ASSMAN) minigame-anim-cache -cfg $(MINIGAME_ANIM_CACHE_CFG) -o $@

$(PWD)/wasm/ads_config.js $(PWD)/wasm/ads.txt: $(PWD)/ads_config.h $(PWD)/scripts/generate_ads_config.py
	python3 $(PWD)/scripts/generate_ads_config.py

main: $(JOLT_LIB) imgui-lib $(VERSION_HEADER) $(VERSION_JSON) $(STAMPED_SW) $(PWA_LOGO_OUTPUT) $(PWA_ICON_192) $(PWA_ICON_512) $(TXL_GENERATED) $(TXL_FONT_GENERATED) $(MINIGAME_ANIM_CACHE_HEADER) $(PWD)/wasm/ads_config.js $(PWD)/wasm/ads.txt font-audit
	mkdir -p build/emscripten/www

	time $(CXX) $(CXXFLAGS) \
		$(PWD)/main.cpp \
		$(PWD)/framework/boot.cpp \
		$(PWD)/game.cpp \
		$(PWD)/sidecar.cpp \
		$(PWD)/physics/physics.cpp \
		$(PLATFORM_SOURCES) \
		$(LDFLAGS) $(LDLIBS) -o build/emscripten/www/index.html 
	cp $(PWD)/wasm/manifest.json build/emscripten/www/manifest.json
	cp $(PWD)/wasm/credits.html build/emscripten/www/credits.html
	cp $(PWD)/wasm/ads_config.js build/emscripten/www/ads_config.js
	cp $(PWD)/wasm/ads.txt build/emscripten/www/ads.txt
	(cd "$(PWD)/build/emscripten/www" && zip -r ../bowling.zip .)

test:
	$(MAKE) -f Makefile.emscripten main \
		&& (cd build/emscripten/www && python3 -mhttp.server 8000)

clean:
	true

.PHONY: main jolt imgui-lib test clean
