# vim: set tabstop=4 shiftwidth=4 expandtab noexpandtab:

#
# DEPENDENCIES:
# 

JOLT_SRC_DIR=$(PWD)/3rdparty/JoltPhysics
JOLT_BUILD_DIR=build/emscripten/jolt
jolt:
	rm -rf $(JOLT_BUILD_DIR)/../usr/lib/libJolt* $(JOLT_BUILD_DIR)
	mkdir -p $(JOLT_BUILD_DIR)
	(cd $(JOLT_BUILD_DIR) && \
	emcmake cmake \
		-DUSE_ASSERTS=ON \
		-DTARGET_SAMPLES=OFF \
		-DTARGET_UNIT_TESTS=OFF \
		-DTARGET_VIEWER=OFF \
		-DCPP_EXCEPTIONS_ENABLED=OFF \
		-DCPP_RTTI_ENABLED=OFF \
		-DBUILD_SHARED_LIBS=OFF \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_ARCHIVE_OUTPUT_DIRECTORY=$(abspath $(JOLT_BUILD_DIR)/../usr/lib) \
		$(abspath $(JOLT_SRC_DIR))/Build && \
	emmake make -j8)

#
# PROGRAM COMPONENTS
# 

CXX = em++

CXXFLAGS = -std=c++20
# Careful! Anyway to set something here needs some terser, fuck that shit
CXXFLAGS += -O0

CXXFLAGS += -I./build/_deps/clay-src
CXXFLAGS += -I./build/_deps/stb-src
CXXFLAGS += -I./3rdparty/JoltPhysics
CXXFLAGS += -I../my-ym2612-plugin/build/_deps/ymfm-src/src
CXXFLAGS += -I./3rdparty/glm
CXXFLAGS += -DJPH_PROFILE_ENABLED=1
CXXFLAGS += -DJPH_DEBUG_RENDERER=1
CXXFLAGS += -DJPH_OBJECT_STREAM=1
CXXFLAGS += -DJPH_ENABLE_ASSERTS=1

LDLIBS += $(PWD)/../my-ym2612-plugin/build/_deps/ymfm-src/src/ymfm_misc.cpp
LDLIBS += $(PWD)/../my-ym2612-plugin/build/_deps/ymfm-src/src/ymfm_adpcm.cpp
LDLIBS += $(PWD)/../my-ym2612-plugin/build/_deps/ymfm-src/src/ymfm_ssg.cpp
LDLIBS += $(PWD)/../my-ym2612-plugin/build/_deps/ymfm-src/src/ymfm_opn.cpp

LDLIBS += -s USE_ZLIB=1
LDLIBS += -s USE_SDL=2
LDLIBS += -s FULL_ES2=1 -s USE_WEBGL2=1
LDLIBS += -s ALLOW_MEMORY_GROWTH=1 -s GL_UNSAFE_OPTS=0
LDLIBS += -s STACK_SIZE=2048kb
LDLIBS += -s EXPORTED_FUNCTIONS=['_main']
# LDLIBS += -s ASSERTIONS=1 -s SAFE_HEAP=1
# LDLIBS += -s USE_PTHREADS=1
LDLIBS += --preload-file $(PWD)/assets/files/everything_tex.png@assets/files/everything_tex.png
# LDLIBS += --preload-file $(PWD)/assets/files/park.jpg@assets/files/park.jpg
LDLIBS += --preload-file $(PWD)/assets/files/Roboto-Regular.ttf@assets/files/Roboto-Regular.ttf
LDLIBS += --preload-file $(PWD)/assets/files/RobotoMono-Regular.ttf@assets/files/RobotoMono-Regular.ttf
LDLIBS += --preload-file $(PWD)/assets/files/NotoSansSC-Regular.ttf@assets/files/NotoSansSC-Regular.ttf
LDLIBS += --preload-file $(PWD)/assets/files/SUSEMono-Medium.ttf@assets/files/SUSEMono-Medium.ttf
LDLIBS += --shell-file $(PWD)/wasm/shell_itch_io.html

LDLIBS += $(PWD)/build/emscripten/usr/lib/libJolt.a
LDLIBS += $(WAV_DATA_LIB)
LDLIBS += $(IMGUI_LIB)

# WAV data include path
CXXFLAGS += -I$(WAV_DATA_DIR)

# WAV data library (built separately to avoid recompiling large data)
WAV_DATA_DIR=$(PWD)/assets/sound_out
WAV_DATA_LIB=$(PWD)/build/emscripten/usr/lib/libwavdata.a
WAV_DATA_OBJS := $(patsubst $(WAV_DATA_DIR)/%.cpp,$(WAV_DATA_DIR)/%.o,$(wildcard $(WAV_DATA_DIR)/*_xxd.cpp))

wav-data-lib: $(WAV_DATA_LIB)

$(WAV_DATA_LIB): $(WAV_DATA_OBJS)
	mkdir -p $(PWD)/build/emscripten/usr/lib
	emar rcs $(WAV_DATA_LIB) $(WAV_DATA_OBJS)

$(WAV_DATA_DIR)/%.o: $(WAV_DATA_DIR)/%.cpp
	em++ -c -O0 $< -o $@

# ImGui library (built separately to avoid recompiling on code changes)
IMGUI_DIR=$(PWD)/3rdparty/imgui
IMGUI_BUILD_DIR=$(PWD)/build/emscripten/imgui
IMGUI_LIB=$(IMGUI_BUILD_DIR)/libimgui.a

imgui-lib: $(IMGUI_LIB)

$(IMGUI_LIB):
	mkdir -p $(IMGUI_BUILD_DIR)
	em++ -c -O0 -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/imgui.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui.o
	em++ -c -O0 -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/imgui_demo.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_demo.o
	em++ -c -O0 -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/imgui_draw.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_draw.o
	em++ -c -O0 -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/imgui_tables.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_tables.o
	em++ -c -O0 -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/imgui_widgets.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_widgets.o
	em++ -c -O0 -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends -s USE_SDL=2 $(IMGUI_DIR)/backends/imgui_impl_sdl2.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_impl_sdl2.o
	em++ -c -O0 -I$(IMGUI_DIR) -I$(IMGUI_DIR)/backends $(IMGUI_DIR)/backends/imgui_impl_opengl3.cpp -DIMGUI_IMPL_OPENGL_ES3 -o $(IMGUI_BUILD_DIR)/imgui_impl_opengl3.o
	emar rcs $(IMGUI_LIB) $(IMGUI_BUILD_DIR)/*.o

CXXFLAGS += -I$(IMGUI_DIR)
CXXFLAGS += -I$(IMGUI_DIR)/backends

main: wav-data-lib imgui-lib
	mkdir -p build/emscripten/www

	time $(CXX) $(CXXFLAGS) \
		$(PWD)/main.cpp \
		$(PWD)/framework/boot.cpp \
		$(PWD)/game.cpp \
		$(PWD)/sidecar.cpp \
		$(PWD)/physics/physics.cpp \
		$(PLATFORM_SOURCES) \
		$(LDFLAGS) $(LDLIBS) -o build/emscripten/www/index.html 
	(cd "$(PWD)/build/emscripten/www" && zip -r ../bowling.zip .)

test:
	make -f Makefile.emscripten main \
		&& (cd build/emscripten/www && python3 -mhttp.server 8000)

clean:
	rm -f build/emscripten/usr/lib/libwavdata.a
	rm -f build/macos/bin/game-wav-exporter
	make run-wav-exporter
	make convert-wavs-to-xxd

.PHONY: main 
