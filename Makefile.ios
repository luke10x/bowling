VERSION_SCRIPT := $(PWD)/scripts/increment_build_version.sh
VERSION_HEADER := $(PWD)/build/generated/build_version.h
IOS_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
IOS_PROJECT := $(IOS_ROOT)/ios-project/ios-project.xcodeproj
IOS_DERIVED_DATA := $(IOS_ROOT)/build/ios/DerivedData
IOS_APP := $(IOS_DERIVED_DATA)/Build/Products/Debug-iphoneos/ios-project.app
IOS_ZIP := $(IOS_ROOT)/build/ios/bowling-ios-debug-unsigned.zip
ADS_CONFIG_SCRIPT := $(IOS_ROOT)/scripts/generate_ads_config.py
ADS_CONFIG_HEADER := $(IOS_ROOT)/ads_config.h
ADS_IOS_GENERATED := $(IOS_ROOT)/ios-project/generated_ads.xcconfig

.PHONY: build zip open ads-config

# Build an unsigned device app. Select a signing team in Xcode to run it on an iPhone.
build: $(ADS_IOS_GENERATED)
	xcodebuild -quiet \
		-project "$(IOS_PROJECT)" \
		-scheme ios-project \
		-configuration Debug \
		-sdk iphoneos \
		-destination 'generic/platform=iOS' \
		-derivedDataPath "$(IOS_DERIVED_DATA)" \
		CODE_SIGNING_ALLOWED=NO \
		build

zip: build
	ditto -c -k --sequesterRsrc --keepParent "$(IOS_APP)" "$(IOS_ZIP)"
	@echo "iOS ZIP: $(IOS_ZIP)"

open: $(ADS_IOS_GENERATED)
	open -a Xcode "$(IOS_PROJECT)"

ads-config: $(ADS_IOS_GENERATED)

$(ADS_IOS_GENERATED): $(ADS_CONFIG_HEADER) $(ADS_CONFIG_SCRIPT)
	python3 "$(ADS_CONFIG_SCRIPT)"

FORCE:

$(VERSION_HEADER): FORCE $(VERSION_SCRIPT)
	@bash $(VERSION_SCRIPT)

SYSROOT=iphoneos
#SYSROOT=iphonesimulator
sdl2:
	#-DCMAKE_OSX_SYSROOT=iphoneos \
	rm -rf build/ios/sdl2
	mkdir -p build/ios/sdl2
	cd build/ios/sdl2 && \
	cmake \
		-G "Unix Makefiles" \
		-DCMAKE_SYSTEM_NAME=iOS \
        -DCMAKE_OSX_SYSROOT=$(SYSROOT) \
		-DCMAKE_OSX_ARCHITECTURES=arm64 \
		-DCMAKE_OSX_DEPLOYMENT_TARGET=12.0 \
		-DCMAKE_INSTALL_PREFIX=$(PWD)/build/ios/usr \
		-DSDL_SHARED=OFF \
		-DSDL_STATIC=ON \
		-DSDL_TEST=OFF \
		$(PWD)/3rdparty/SDL && \
	make -j && \
	make install

JOLT_SRC_DIR=$(PWD)/3rdparty/JoltPhysics
JOLT_BUILD_DIR=build/ios/jolt

jolt:
	rm -rf $(JOLT_BUILD_DIR)/../usr/lib/libJolt* $(JOLT_BUILD_DIR)
	mkdir -p $(JOLT_BUILD_DIR)
	(cd $(JOLT_BUILD_DIR) && \
	cmake \
		-DCMAKE_SYSTEM_NAME=iOS \
        -DCMAKE_OSX_SYSROOT=$(SYSROOT) \
		-DCMAKE_OSX_ARCHITECTURES=arm64 \
		-DCMAKE_OSX_DEPLOYMENT_TARGET=13.0 \
		-DENABLE_BITCODE=OFF \
		-DUSE_ASSERTS=ON \
		-DTARGET_SAMPLES=OFF \
		-DTARGET_UNIT_TESTS=OFF \
		-DTARGET_VIEWER=OFF \
		-DCPP_EXCEPTIONS_ENABLED=OFF \
		-DCPP_RTTI_ENABLED=OFF \
		-DBUILD_SHARED_LIBS=OFF \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_ARCHIVE_OUTPUT_DIRECTORY=$(abspath $(JOLT_BUILD_DIR)/../usr/lib) \
		$(abspath $(JOLT_SRC_DIR))/Build && \
	cmake --build . --config Release --parallel)
