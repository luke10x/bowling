// iOS Project Build Configuration
// Production IDs; the Xcode Debug configuration uses Google's sample IDs.
ADMOB_IOS_APP_ID = ca-app-pub-2747257038106344~8933832565
ADMOB_IOS_LOSS_UNIT = ca-app-pub-2747257038106344/2790351187

// Header search paths
HEADER_SEARCH_PATHS = \
    $(PROJECT_DIR)/../build/ios/usr/include \
    $(PROJECT_DIR)/../3rdparty/JoltPhysics \
    $(PROJECT_DIR)/../3rdparty/glm \
    $(PROJECT_DIR)/../3rdparty/stb \
    $(PROJECT_DIR)/../3rdparty/imgui \
    $(PROJECT_DIR)/../build/_deps/clay-src \
    $(PROJECT_DIR)/../../eggsfm \
    $(PROJECT_DIR)/../../ymfm/src \
    $(PROJECT_DIR)/../3rdparty/JoltPhysics/** \
    $(PROJECT_DIR)/../3rdparty/glm/** \
    $(PROJECT_DIR)/../3rdparty/stb/** \
    $(PROJECT_DIR)/../3rdparty/imgui/** \
    $(PROJECT_DIR)/../build/_deps/clay-src/** \
    $(PROJECT_DIR)/../../eggsfm/** \
    $(PROJECT_DIR)/../../ymfm/src/** \
    $(PROJECT_DIR)/..
   //Project->Targets->General->"Scan All Source Files For Includes"-> set to "Yes"

 
// Library search paths
LIBRARY_SEARCH_PATHS = \
    $(PROJECT_DIR)/../build/ios/usr/lib

// Link static libraries
OTHER_LDFLAGS = \
    -lSDL2 \
    -lSDL2main \
    -lJolt \
    -framework OpenGLES \
    -framework UIKit \
    -framework Foundation \
    -framework CoreGraphics \
    -framework QuartzCore

// C++ standard
CPLUSPLUS_LANGUAGE_STANDARD = c++17
